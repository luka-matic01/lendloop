# ==============================================================================
# LendLoop — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for Next.js + Docker Compose.
# Set the backend-only variables (`CLERK_JWT_ISSUER_DOMAIN`, `WEBHOOK_HMAC_SECRET`,
# `N8N_REQUEST_WEBHOOK_URL`, `INITIAL_ADMIN_EMAIL`) in your Convex deployment
# via `npx convex env set <KEY> <VALUE>`.
#
# SECURITY NOTE: Never commit real secrets to Git or inside `/n8n/*.json` exports.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Backend (Client + HTTP Actions URL)
# ------------------------------------------------------------------------------
# Populated automatically when you run `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
# Convex HTTP Actions base URL (always ends in .convex.site)
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ------------------------------------------------------------------------------
# 2. Clerk Authentication
# ------------------------------------------------------------------------------
# Get these from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk JWT Template Issuer Domain (from Clerk Dashboard -> JWT Templates -> "convex")
# Also set this in Convex: `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-clerk-domain.clerk.accounts.dev`
# In the "convex" JWT template, include claims: email, email_verified (required for admin bootstrap).
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Optional Clerk route overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 3. Role-Based Access Control (Admin Bootstrap)
# ------------------------------------------------------------------------------
# Optional email address that is automatically granted `admin` role upon first sign-in.
# Set in Convex: `npx convex env set INITIAL_ADMIN_EMAIL admin@example.com`
INITIAL_ADMIN_EMAIL=

# ------------------------------------------------------------------------------
# 4. Bidirectional Webhook Security (Convex <-> n8n)
# ------------------------------------------------------------------------------
# Generate a strong 32-byte hex secret: `openssl rand -hex 32`
# Must match in both Convex (`npx convex env set WEBHOOK_HMAC_SECRET ...`) and n8n container env
WEBHOOK_HMAC_SECRET=replace_with_64_char_hex_from_openssl_rand_hex_32

# Webhook endpoint exposed by n8n Workflow 1 (Request Notification)
# When running n8n locally via Docker and Convex in the cloud, use an ngrok/cloudflared tunnel
# or n8n Cloud URL so Convex cloud actions can reach your n8n webhook.
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request-events

# ------------------------------------------------------------------------------
# 5. n8n Self-Hosted Docker Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_32_char_random_encryption_key
GENERIC_TIMEZONE=Europe/Sarajevo
